# Local Docker Postgres only. Do not paste this into Railway.
# On Railway, add DATABASE_URL as a *reference* to Postgres.DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice_generator"

# Random string, at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Used only when running `npm run db:seed` in production.
# Leave unset locally to load the demo accounts.
# ADMIN_EMAIL="you@company.com"
# ADMIN_PASSWORD="choose-a-strong-password"
# ADMIN_NAME="Admin"

# Stripe price for one pack of 5 seats. The price itself is monthly, in SGD.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."
